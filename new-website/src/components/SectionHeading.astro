---
import Ornament from '@/components/Ornament.astro';

interface Props {
  title: string;
  eyebrow?: string;
  align?: 'center' | 'left';
  id?: string;
}
const { title, eyebrow, align = 'center', id } = Astro.props;
---

<div class:list={['mb-10', align === 'center' ? 'text-center' : 'text-left']}>
  {eyebrow && <p class="mb-2 text-sm font-semibold tracking-[0.18em] text-peacock-700 uppercase">{eyebrow}</p>}
  <h2 id={id} class="font-serif text-3xl text-maroon-700 sm:text-4xl">{title}</h2>
  {align === 'center' && <Ornament class="mt-4 text-gold-500" />}
</div>
