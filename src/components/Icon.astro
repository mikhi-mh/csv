export type IconName = keyof typeof icons;

interface Props {
  name: IconName;
  class?: string;
  label?: string;
}
const { name, class: className = 'size-5', label } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 24 24"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
  set:html={icons[name]}
/>
